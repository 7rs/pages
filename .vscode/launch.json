{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "i",
            "type": "node-terminal",
            "request": "launch",
            "command": "bun i"
        },
        {
            "name": "dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "bun run dev"
        },
        {
            "name": "build",
            "type": "node-terminal",
            "request": "launch",
            "command": "bun run build"
        },
        {
            "name": "build & preview",
            "type": "node-terminal",
            "request": "launch",
            "command": "bun run prev"
        },
        {
            "name": "wasm",
            "type": "node-terminal",
            "request": "launch",
            "command": "wasm-pack build --target web --out-dir ../../../public/boorufind",
            "cwd": "${workspaceFolder}/scripts/boorufind/boorufind-wasm"
        }
    ]
}
