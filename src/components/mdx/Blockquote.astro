---
import { getTextContent } from "@scripts/dom";
import Anchor from "@components/Anchor.astro";

interface Props {
  url: string;
  title?: string;
}
const { url, title } = Astro.props;
---

<blockquote
  cite={url}
  class="my-4 py-2 px-4 | flex flex-col gap-y-2 | border-l-4 border-l-[var(--color-info)] bg-base-300 font-italic"
>
  <slot />
  <Anchor href={url} class="w-fit">
    {async () => title ?? (await getTextContent(url, "head>title"))}
  </Anchor>
</blockquote>
