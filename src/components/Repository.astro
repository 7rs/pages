---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

const HostingServices = {
  GitHub: "https://api.github.com/repos",
  GitLab: "https://gitlab.com/api/v4/projects",
} as const;
type HostingServices = (typeof HostingServices)[keyof typeof HostingServices];

interface Props extends HTMLAttributes<"article"> {
  userName: string;
  repositoryName: string;
  hosting?: HostingServices;
}

const { userName, repositoryName, hosting = HostingServices.GitHub, ...props } = Astro.props;

const repository = await fetch(`${hosting}/${userName}/${repositoryName}`)
  .then((raw) => raw.json())
  .then((response) => {
    return response;
  })
  .catch((err) => console.error(err));
const languages = await fetch(`${hosting}/${userName}/${repositoryName}/languages`)
  .then((raw) => raw.json())
  .then((response: { [lang: string]: number }) => {
    const langs = Object.keys(response);
    const percentages = {};

    let total = 0;
    for (const lang of langs) {
      total += response[lang];
    }

    for (const lang of langs) {
      percentages[lang] = (response[lang] / total).toFixed(2);
    }

    return percentages;
  })
  .catch((err) => console.error(err));

console.log(languages);
---

<article class="card card-md w-fit | bg-base-100 shadow-sm" {...props}>
  <div class="card-body w-fit">
    <section class="flex justify-center gap-x-4">
      <hgroup class="flex flex-col">
        <h2 class="text-xl font-bold">{repository.full_name}</h2>
        <p>{repository.description}</p>
      </hgroup>
      <div class="avatar">
        <div class="w-12 rounded-full">
          <img src={repository.owner.avatar_url} />
        </div>
      </div>
    </section>
    <section class="flex justify-center text-center">
      <div class="flex items-center gap-x-2">
        <span class="block h-4 w-4 bg-red rounded-full"></span>
        <p>{repository.language}</p>
      </div>
      <p><Icon class="inline" name="tabler:git-fork" /> {repository.forks_count}</p>
      <p><Icon class="inline" name="tabler:star" /> {repository.stargazers_count}</p>
    </section>
  </div>
</article>
