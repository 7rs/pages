---
import { Icon } from "astro-icon/components";

import Anchor from "@components/Anchor.astro";
import type { Props as AnchorProps } from "@components/Anchor.astro";

interface Props extends AnchorProps {
  icon: string;
  color?: string;
}
const { icon, color, ...props } = Astro.props;
---

<Anchor class="relative hover:scale-125 transition-all [&>svg]:hover:color-secondary" {...props}>
  <Icon class="text-2xl z-1" name={icon} />
  <Icon class="text-2xl absolute top-0 hover:animate-ping z-0" name={icon} />
</Anchor>
