---
import type { Props as RingProps } from "@components/Ring.astro";
import Ring from "@components/Ring.astro";
import DescriptionList from "./DescriptionList.astro";

interface Props extends RingProps {
  mainText: string;
}

const { mainText, ...props } = Astro.props;
---

<div class="flex flex-col justify-center items-center">
  <Ring {...props}>{mainText}</Ring>
  <DescriptionList>
    <slot />
  </DescriptionList>
</div>
