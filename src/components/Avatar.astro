---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  className: string;
  size?: number;
}

const { src, className = "", size = 128 } = Astro.props;
---

<article class:list={["avatar", className]}>
  <Picture class="rounded-full" src={src} formats={["avif", "jpg"]} alt="avatar" width={size} height={size} />
</article>
