---
import { Icon } from "astro-icon/components";

export interface Props {
  tabName: string;
  icon?: string;
  checked?: boolean;
  className?: string;
}

const { tabName, icon, checked = false, className = "" } = Astro.props;
---

<label class="tab text-base">
  {
    checked ? (
      <input type="radio" name="tab-button" checked="checked" />
    ) : (
      <input type="radio" name="tab-button" />
    )
  }
  {icon && <Icon class="size-4 me-2" name={icon} />}
  <span class="hidden md:inline">{tabName}</span>
</label>
<div class:list={["tab-content", className]}>
  <slot />
</div>
