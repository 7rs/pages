---
import { Icon } from "astro-icon/components";

export interface Props {
  progress: number;
  label: string;
  icon: string;
}

const { progress, icon, label } = Astro.props;
---

<article class="w-fit flex flex-col items-center">
  <div class="radial-progress" style={`--value:${progress};`} aria-valuenow={progress} role="progressbar">
    <div class="tooltip" data-tip={label}>
      <Icon class="text-2xl hover:saturate-100 hover:scale-125 transition-all saturate-0" name={icon} />
    </div>
  </div>
  <p>{progress}%</p>
</article>
