---
import type { Page } from "astro";
import Icon from "@components/Icon.astro";

interface Props {
  page: Page;
  baseUrl: string;
}
const { page, baseUrl } = Astro.props;

const pageNumberInputId = "page-number-input";
const lastPage = page.lastPage;
const currentPage = page.currentPage;
---

<article class="w-fit flex shadow-md self-center">
  <div class="tooltip" data-tip={page.url.first && "page 1"}>
    <a href={page.url.first} class="join-item btn">
      <Icon name="line-md:chevron-small-double-left" />
    </a>
  </div>

  <div class="tooltip" data-tip={page.url.prev && `page ${page.currentPage - 1}`}>
    <a href={page.url.prev} class="join-item btn">
      <Icon name="line-md:chevron-small-left" />
    </a>
  </div>

  <input
    type="number"
    placeholder={`${page.currentPage} / ${page.lastPage}`}
    id={pageNumberInputId}
    class="input input-ghost focus:outline-none text-center pagenation-input"
  />

  <div class="tooltip" data-tip={page.url.next && `page ${page.currentPage + 1}`}>
    <a href={page.url.next} class="join-item btn">
      <Icon name="line-md:chevron-small-right" />
    </a>
  </div>

  <div class="tooltip" data-tip={page.url.last && `page ${page.lastPage}`}>
    <a href={page.url.last} class="join-item btn">
      <Icon name="line-md:chevron-small-double-right" />
    </a>
  </div>
</article>

<script define:vars={{ pageNumberInputId, baseUrl, lastPage, currentPage }}>
  document.getElementById(pageNumberInputId).addEventListener("keypress", (e) => {
    if (e.key !== "Enter") {
      return;
    }

    const pageNumber = parseInt(e.target.value);
    if (Number.isNaN(pageNumber) || pageNumber <= 0 || lastPage < pageNumber) {
      alert("Specified the invalid page number.");

      return;
    }

    if (pageNumber === currentPage) {
      alert("Your specified page number is the current.");

      return;
    }

    window.location.href = `${baseUrl}/${pageNumber}`;
  });
</script>
