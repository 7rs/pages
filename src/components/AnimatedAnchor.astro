---
import Anchor from "@components/Anchor.astro";

const { ...props } = Astro.props;
---

<Anchor class="relative link [&>span]:hover:w-full" {...props}>
  <slot />
  <span class="absolute top-0 left-0 | h-full w-0 | opacity-25 bg-secondary transition-all transition-duration-200"></span>
</Anchor>
