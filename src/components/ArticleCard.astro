---
import type { Blog as BlogFrontmatter } from "@content/config";
import Symbol from "@components/Symbol.astro";
import { hasIcon } from "@scripts/icon";
import AnimatedAnchor from "@components/AnimatedAnchor.astro";
import Icon from "@components/Icon.astro";

interface Props {
  slug: string;
  frontmatter: BlogFrontmatter;
}

const { slug, frontmatter } = Astro.props;
---

<a href={`/b/${slug}`}>
  <article
    class:list={[
      "p-4 hover:b-1",
      "grid grid-cols-[auto_1fr] justify-center items-center gap-y-1 gap-x-2",
      "shadow-md rounded-xl border-white bg-base-100",
    ]}
  >
    <div class="grid-area-[symbol] | size-12 | flex justify-center items-center">
      <Symbol image={frontmatter.image ? frontmatter.image : ":question:"} className="size-8" />
    </div>
    <hgroup class="grid-area-[summary] flex flex-col gap-y-1 text-wrap">
      <h3 class="text-base font-bold">{frontmatter.title}</h3>
      <p class="color-[var(--color-base-content)]/75 text-sm">
        {frontmatter.description.length <= 0 ? "説明なし" : frontmatter.description}
      </p>
    </hgroup>
    <section class="grid-area-[content]">
      {
        frontmatter.tags.map((tag) => {
          return (
            <AnimatedAnchor href={`/tags/${tag}`} openAsNew={false}>
              {() => {
                const provider = hasIcon(tag);
                if (provider == null) {
                  return;
                }

                return <Icon class="inline no-underline border-b-1" name={`${provider.provider}:${provider.name}`} />;
              }}
              #{tag}
            </AnimatedAnchor>
          );
        })
      }
      {frontmatter.tags.length <= 0 && "No tags"}
    </section>
  </article>
</a>

<style lang="scss">
  article {
    grid-template-areas:
      "symbol  summary"
      "content content";
  }
</style>
