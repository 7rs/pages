---
import AnimatedAnchor from "@components/AnimatedAnchor.astro";
import { hasIcon } from "@scripts/icon";
import Icon from "@components/Icon.astro";

interface Props {
  tags?: string[];
  className?: string;
  childClassName?: string;
}
const { tags = [], className = "", childClassName = "" } = Astro.props;
---

<div
  class:list={[
    "w-full flex flex-wrap gap-x-2 | border-color-[#337ab7] color-[#337ab7] text-base",
    className,
  ]}
>
  {
    tags.length > 0 ? (
      tags.map((tag) => {
        const provider = hasIcon(tag);

        return (
          <AnimatedAnchor href={`/tags/${tag}`} openAsNew={false} class={childClassName}>
            {provider && <Icon class="inline no-underline border-b-1" name={`${provider.provider}:${provider.name}`} />}
            #{tag}
          </AnimatedAnchor>
        );
      })
    ) : (
      <p>#no-tags</p>
    )
  }
</div>
