---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  icon: string;
}

const { title, icon } = Astro.props;
---

<article class="grid grid-cols-[auto_auto_1fr] items-center w-full gap-x-1">
  <div class="max-md:tooltip-open tooltip px-2 md:px-0" data-tip={title}>
    <Icon class="block flex-none w-8 h-8 hover:scale-125 transition-all p-1 md:p-0" name={icon} />
  </div>
  <div class="divider divider-horizontal flex-none m-0"></div>
  <p class="flex-1"><slot /></p>
</article>
