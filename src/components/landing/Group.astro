---
import { Icon } from "astro-icon/components";

export interface Props {
  icon?: string;
  label: string;
}

const { icon, label } = Astro.props;
---

<fieldset
  class="border border-[var(--color-base-content)] hover:border-[var(--color-primary)] | px-2 | rounded-md transition-all"
>
  <legend class="px-2 | flex items-center gap-x-1 | text-base">
    {icon && <Icon name={icon} />}
    <p>{label}</p>
  </legend>
  <div class="p-4 | flex flex-wrap gap-2 items-center content-center">
    <slot />
  </div>
</fieldset>
