---
import { getLinearDirection } from "@scripts/colored-text.ts";
interface Props {
  title: string;
  titleClassName?: string;
}

const { title, titleClassName = "" } = Astro.props;
---

<section class="flex flex-col gap-y-4 md:gap-y-8">
  <h2
    id={title.replaceAll(" ", "-").toLowerCase()}
    class:list={[
      "py-2 px-2 | bg-clip-text color-transparent text-2xl md:text-5xl font-bold",
      // isTextStart(titleClassName) ? "bg-linear-to-r" : "bg-linear-to-l",
      getLinearDirection(titleClassName),
      titleClassName,
    ]}
  >
    {title}
  </h2>
  <slot />
</section>
