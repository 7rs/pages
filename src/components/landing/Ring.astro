---
import { Icon } from "astro-icon/components";
import { getLinearDirection } from "@scripts/colored-text.ts";
import { type RingIcon } from "@components/landing/RingContent.astro";

export interface Props {
  items: RingIcon[];
  subText?: string;
  playbackTime?: number;
  size?: number;
  rainbowPlaybackTime?: number;
  rainbowSize?: number;
  useLinearGradient?: boolean;
  reverseLinearDirection?: boolean;
  catchCopyClassNames?: string;
}

const {
  items,
  subText,
  playbackTime = 15000,
  rainbowPlaybackTime = 20000,
  size = 8,
  rainbowSize = 8,
  useLinearGradient = false,
  reverseLinearDirection = false,
  catchCopyClassNames = "",
} = Astro.props;
---

<article>
  <div class=`relative flex items-center`>
    <hgroup
      style={`--rainbowPlaybackTime: ${rainbowPlaybackTime}ms`}
      class:list={[
        "relative z-1 | flex flex-col text-center justify-center gap-y-2",
        "animate-[rainbow_var(--rainbowPlaybackTime)_linear_infinite_forwards]",
        useLinearGradient
          ? `bg-clip-text color-transparent ${reverseLinearDirection ? "bg-linear-to-l" : "bg-linear-to-r"}`
          : "color-white",
        catchCopyClassNames,
      ]}
    >
      <h2 class="text-4xl font-bold"><slot /></h2>
      {subText && <p>{subText}</p>}
    </hgroup>
    {
      items.map((item, i) => (
        <Icon
          style={`--playbackTime: ${playbackTime}ms; animation-delay: -${Math.floor(playbackTime / items.length) * i}ms`}
          class:list={[
            "absolute top-1/2 left-1/2 z-0 | translate-x--1/2 translate-y--1/2 | h-full | text-3xl",
            "animate-[rotate_var(--playbackTime)_linear_infinite_forwards]",
            "opacity-0",
            item.className && item.className,
          ]}
          title={item.name}
          name={item.icon}
        />
      ))
    }
  </div>
</article>

<style lang="scss" define:vars={{ ringSize: `${size}rem`, dropShadowSize: `${rainbowSize}px` }}>
  @keyframes rotate {
    from {
      opacity: 100%;
      transform: rotate(0deg) translateY(100%) rotate(0deg);
    }
    to {
      opacity: 100%;
      transform: rotate(360deg) translateY(100%) rotate(-360deg);
    }
  }

  @keyframes rainbow {
    0% {
      filter: drop-shadow(0 0 var(--dropShadowSize) red);
    }
    14% {
      filter: drop-shadow(0 0 var(--dropShadowSize) orange);
    }
    28% {
      filter: drop-shadow(0 0 var(--dropShadowSize) yellow);
    }
    42% {
      filter: drop-shadow(0 0 var(--dropShadowSize) green);
    }
    56% {
      filter: drop-shadow(0 0 var(--dropShadowSize) cyan);
    }
    70% {
      filter: drop-shadow(0 0 var(--dropShadowSize) indigo);
    }
    84% {
      filter: drop-shadow(0 0 var(--dropShadowSize) purple);
    }
    100% {
      filter: drop-shadow(0 0 var(--dropShadowSize) red);
    }
  }

  article {
    padding-top: var(--ringSize);
    padding-bottom: var(--ringSize);
  }

  div {
    height: var(--ringSize);
  }
</style>
