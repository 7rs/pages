---
import Icon from "@components/Icon.astro";

interface Props {
  icon: string;
  label: string;
}

const { icon, label } = Astro.props;
---

<article class="relative | tooltip [&>svg]:hover:color-[var(--colorProperty)]" data-tip={label}>
  <Icon class="text-2xl" name={icon} />
  <Icon class="z-0 absolute top-0 | text-2xl | hover:animate-ping" name={icon} />
</article>
