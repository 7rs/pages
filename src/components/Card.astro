---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"article"> {
  icon: string;
  title: string;
}

const { icon, title, ...props } = Astro.props;
---

<article class="card card-md | bg-base-100 shadow-sm" {...props}>
  <div class="card-body">
    <h2 class="card-title">
      <Icon class="inline" name={icon} />{title}
    </h2>
    <p class="text-base">
      <slot />
    </p>
  </div>
</article>
