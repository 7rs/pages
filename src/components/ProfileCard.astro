---
import Avatar from "@components/Avatar.astro";

import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  avatar: ImageMetadata;
}

const { name, avatar } = Astro.props;
---

<article class="flex flex-col md:flex-row items-center justify-center gap-x-8 gap-y-2">
  <Avatar src={avatar} className="size-20" />
  <hgroup class="max-w-md | flex flex-col gap-y-2 | text-center md:text-start">
    <h3 class="text-4xl font-bold">{name}</h3>
    <p>
      <slot />
    </p>
  </hgroup>
</article>
