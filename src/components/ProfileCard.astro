---
import type { ImageMetadata } from "astro";
import Avatar from "@components/Avatar.astro";

interface Props {
  name: string;
  avatar: ImageMetadata;
}

const { name, avatar } = Astro.props;
---

<article class="flex flex-col md:flex-row items-center justify-center gap-x-8">
  <Avatar src={avatar} className="h-20" />
  <hgroup class="flex flex-col gap-y-4 max-w-md">
    <h3 class="text-4xl text-center md:text-start">{name}</h3>
    <p>
      <slot />
    </p>
  </hgroup>
</article>
