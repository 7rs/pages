---
interface Props {
  title: string;
  titleClassName?: string;
}

const { title, titleClassName = "" } = Astro.props;

const isTextStart = (() => {
  for (const property of titleClassName.split(" ")) {
    return property === "text-start";
  }
})();
---

<section class="flex flex-col gap-y-4 md:gap-y-8">
  <h2
    id={title.replaceAll(" ", "-").toLowerCase()}
    class:list={[
      "px-2 py-2 text-2xl md:text-5xl font-bold",
      isTextStart ? "bg-linear-to-r" : "bg-linear-to-l",
      titleClassName,
    ]}
  >
    {title}
  </h2>
  <slot />
</section>
