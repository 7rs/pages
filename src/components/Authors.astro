---
import AnimatedAnchor from "@components/AnimatedAnchor.astro";

interface Props {
  authors?: string[];
  className?: string;
  childClassName?: string;
}
const { authors = [], className = "", childClassName = "" } = Astro.props;
---

<div class:list={["w-full flex flex-wrap gap-x-2 | color-[#A00]", className]}>
  {
    authors.length > 0 ? (
      authors.map((author) => (
        <AnimatedAnchor href={`/authors/${author}`} openAsNew={false} class={childClassName}>
          @{author}
        </AnimatedAnchor>
      ))
    ) : (
      <p>@unknown</p>
    )
  }
</div>
