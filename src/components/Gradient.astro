<canvas id="graphic" width="1024" height="1024" class:list={["fixed z-0 top-0 left-0", "w-full h-lvh", "opacity-25 blur-[16px]", className]}>
</canvas>
    <script define:vars={{ shaders, precomputedPaths, precomputedEllipse, precomputedKernel, colorThemes, selectedTheme, colorTransitionConfig, colorSequence }}>
  /**
   * @type {HTMLCanvasElement}
   */
  const canvas = document.getElementById("graphic");
  if (!canvas) {
    throw new Error("Canvas not found");
  }

  /**
   * @type {WebGLRenderingContext}
   */
  const gl = canvas.getContext("webgl");
  if (gl == null) {
    throw new Error("WebGL not supported");
  }

  // キャンバスサイズを自動取得（フォールバック: 1024x1024）
  const canvasWidth = canvas.width || 1024;
  const canvasHeight = canvas.height || 1024;

  class WebGLAPI {
    /** @type {WebGLRenderingContext} */
    ctx;

    /** @param {WebGLRenderingContext} glContext */
    constructor(glContext) {
      this.ctx = glContext;
    }

    /**
     * @param {GLenum} type
     * @param {string} source
     * @returns {WebGLShader}
     */
    createShader(type, source) {
      const shader = this.ctx.createShader(type);
      if (shader == null) {
        throw new Error(`Invalid shader: ${type}`);
      }

      this.ctx.shaderSource(shader, source);
      this.ctx.compileShader(shader);

      if (!this.ctx.getShaderParameter(shader, this.ctx.COMPILE_STATUS)) {
        const error = this.ctx.getShaderInfoLog(shader);
        this.ctx.deleteShader(shader);
        throw new Error(`Couldn't compile shader: ${error}`);
      }

      return shader;
    }

    /**
     * @param {WebGLShader[]} shaders
     * @returns {WebGLProgram}
     */
    createProgram(shaders) {
      const program = this.ctx.createProgram();
      for (const shader of shaders) {
        this.ctx.attachShader(program, shader);
      }
      this.ctx.linkProgram(program);

      if (!this.ctx.getProgramParameter(program, this.ctx.LINK_STATUS)) {
        const error = this.ctx.getProgramInfoLog(program);
        this.ctx.deleteProgram(program);
        throw new Error(`Couldn't link program: ${error}`);
      }

      return program;
    }

    /**
     * @param {WebGLShader[]} shaders
     * @param {string[]} attributes
     * @param {string[]} uniforms
     * @returns {{program: WebGLProgram, locations: Object}}
     */
    createProgramWithLocations(shaders, attributes, uniforms) {
      const program = this.createProgram(shaders);
      const locations = {};

      for (const attr of attributes) {
        locations[attr] = this.ctx.getAttribLocation(program, attr);
      }

      for (const uniform of uniforms) {
        locations[uniform] = this.ctx.getUniformLocation(program, uniform);
      }

      return { program, locations };
    }

    /**
     * @param {number} width
     * @param {number} height
     * @returns {WebGLTexture}
     */
    createTexture(width, height) {
      const texture = this.ctx.createTexture();
      this.ctx.bindTexture(this.ctx.TEXTURE_2D, texture);
      this.ctx.texImage2D(
        this.ctx.TEXTURE_2D,
        0,
        this.ctx.RGBA,
        width,
        height,
        0,
        this.ctx.RGBA,
        this.ctx.UNSIGNED_BYTE,
        null,
      );
      this.ctx.texParameteri(this.ctx.TEXTURE_2D, this.ctx.TEXTURE_MIN_FILTER, this.ctx.LINEAR);
      this.ctx.texParameteri(this.ctx.TEXTURE_2D, this.ctx.TEXTURE_MAG_FILTER, this.ctx.LINEAR);
      this.ctx.texParameteri(this.ctx.TEXTURE_2D, this.ctx.TEXTURE_WRAP_S, this.ctx.CLAMP_TO_EDGE);
      this.ctx.texParameteri(this.ctx.TEXTURE_2D, this.ctx.TEXTURE_WRAP_T, this.ctx.CLAMP_TO_EDGE);
      return texture;
    }

    /**
     * @param {WebGLTexture} texture
     * @returns {WebGLFramebuffer}
     */
    createFramebuffer(texture) {
      const framebuffer = this.ctx.createFramebuffer();
      this.ctx.bindFramebuffer(this.ctx.FRAMEBUFFER, framebuffer);
      this.ctx.framebufferTexture2D(this.ctx.FRAMEBUFFER, this.ctx.COLOR_ATTACHMENT0, this.ctx.TEXTURE_2D, texture, 0);
      return framebuffer;
    }

    /**
     * @param {Float32Array} data
     * @returns {WebGLBuffer}
     */
    createBuffer(data) {
      const buffer = this.ctx.createBuffer();
      this.ctx.bindBuffer(this.ctx.ARRAY_BUFFER, buffer);
      this.ctx.bufferData(this.ctx.ARRAY_BUFFER, data, this.ctx.STATIC_DRAW);
      return buffer;
    }

    /**
     * @param {number} width
     * @param {number} height
     */
    initRenderer(width, height) {
      this.ctx.viewport(0, 0, width, height);
      this.ctx.clearColor(0.1, 0.15, 0.2, 1.0);
      this.ctx.clear(this.ctx.COLOR_BUFFER_BIT);
    }

    /**
     * @param {number[]} vertices
     * @param {number[]} color
     * @param {Object} transform
     * @param {WebGLBuffer} positionBuffer
     * @param {Object} locations
     */
    drawShape(vertices, color, transform, positionBuffer, locations) {
      if (vertices.length < 6) return;

      // 変換適用
      const transformedVertices = [];
      for (let i = 0; i < vertices.length; i += 2) {
        let x = vertices[i];
        let y = vertices[i + 1];

        // スケール
        x *= transform.scale;
        y *= transform.scale;

        // 回転
        if (transform.rotation) {
          const cos = Math.cos(transform.rotation);
          const sin = Math.sin(transform.rotation);
          const rotatedX = x * cos - y * sin;
          const rotatedY = x * sin + y * cos;
          x = rotatedX;
          y = rotatedY;
        }

        // 移動
        x += transform.translateX;
        y += transform.translateY;

        transformedVertices.push(x, y);
      }

      this.ctx.bindBuffer(this.ctx.ARRAY_BUFFER, positionBuffer);
      this.ctx.bufferData(this.ctx.ARRAY_BUFFER, new Float32Array(transformedVertices), this.ctx.STATIC_DRAW);
      this.ctx.enableVertexAttribArray(locations.a_position);
      this.ctx.vertexAttribPointer(locations.a_position, 2, this.ctx.FLOAT, false, 0, 0);
      this.ctx.uniform4fv(locations.u_color, color);

      // まずLINE_LOOPで輪郭を描画（完璧な曲線）
      this.ctx.lineWidth(2.0);
      this.ctx.drawArrays(this.ctx.LINE_LOOP, 0, transformedVertices.length / 2);
      
      // 次にTRIANGLE_FANで塗りつぶし（中心を計算）
      const centerX = transformedVertices.reduce((sum, val, i) => i % 2 === 0 ? sum + val : sum, 0) / (transformedVertices.length / 2);
      const centerY = transformedVertices.reduce((sum, val, i) => i % 2 === 1 ? sum + val : sum, 0) / (transformedVertices.length / 2);
      
      // 中心点を先頭に追加した配列を作成
      const fanVertices = [centerX, centerY, ...transformedVertices, transformedVertices[0], transformedVertices[1]];
      
      this.ctx.bufferData(this.ctx.ARRAY_BUFFER, new Float32Array(fanVertices), this.ctx.STATIC_DRAW);
      this.ctx.drawArrays(this.ctx.TRIANGLE_FAN, 0, fanVertices.length / 2);
    }

    /**
     * @param {number[]} vertices
     * @param {number} time
     * @param {number} shapeIndex
     * @returns {number[]}
     */
    animateVertices(vertices, time, shapeIndex, config) {
      const animatedVertices = [];
      const frequency = 0.3 + shapeIndex * 0.15; // より低い周期でゆったり
      const amplitude = 8.0 + shapeIndex * 3.0; // 揺れ幅を大きく
      const speed = config.animation.vertexSpeed; // 設定可能な速度

      for (let i = 0; i < vertices.length; i += 2) {
        const x = vertices[i];
        const y = vertices[i + 1];

        // 揺れ幅を大きくした波の組み合わせ
        const wave1 = amplitude * 0.8 * Math.sin(time * speed * frequency + i * 0.01 + x * 0.003);
        const wave2 = amplitude * 0.7 * Math.cos(time * speed * frequency * 1.2 + i * 0.015 + y * 0.002);

        // 円形の波動効果（強め）
        const distance = Math.sqrt(x * x + y * y);
        const radialWave = amplitude * 0.6 * Math.sin(time * speed * 0.5 + distance * 0.005);

        // 螺旋の動き（強め）
        const angle = Math.atan2(y, x);
        const spiralWave = amplitude * 0.4 * Math.sin(time * speed * 0.4 + angle * 2 + distance * 0.008);

        animatedVertices.push(
          x + wave1 + radialWave * Math.cos(angle * 0.5) + spiralWave * 0.7,
          y + wave2 + radialWave * Math.sin(angle * 0.5) + spiralWave * 0.7,
        );
      }

      return animatedVertices;
    }

    /**
     * @param {number[]} baseColor
     * @param {number} time
     * @param {number} shapeIndex
     * @returns {number[]}
     */
    animateColors(baseColor, time, shapeIndex, config) {
      if (colorTransitionConfig.enableTransition) {
        // 従来のsin波アニメーション - baseColorがnullの場合は初期色を使用
        const fallbackColor = baseColor || (shapeIndex < 0 
          ? [209/255, 237/255, 247/255, 1] 
          : precomputedPaths[shapeIndex]?.color || [1, 1, 1, 1]);
        
        const colorSpeed = config.animation.colorSpeed;
        const intensity = 0.15;
        return [
          Math.max(0, Math.min(1, fallbackColor[0] + intensity * Math.sin(time * colorSpeed + shapeIndex))),
          Math.max(0, Math.min(1, fallbackColor[1] + intensity * Math.sin(time * colorSpeed * 1.2 + shapeIndex + 1))),
          Math.max(0, Math.min(1, fallbackColor[2] + intensity * Math.sin(time * colorSpeed * 0.8 + shapeIndex + 2))),
          1.0,
        ];
      }

      // 色遷移アニメーション
      if (!this.colorTransitions) {
        this.initColorTransitions();
      }

      // shapeIndexを配列インデックスに変換（楕円は-1なので最後の要素）
      const transitionIndex = shapeIndex < 0 ? this.colorTransitions.length - 1 : shapeIndex;
      
      if (transitionIndex >= this.colorTransitions.length) {
        console.warn(`Invalid transitionIndex: ${transitionIndex}, using fallback color`);
        return shapeIndex < 0 
          ? [209/255, 237/255, 247/255, 1] 
          : precomputedPaths[shapeIndex]?.color || [1, 1, 1, 1];
      }

      const transition = this.colorTransitions[transitionIndex];
      if (!transition) {
        console.warn(`No transition found for index: ${transitionIndex}, using fallback color`);
        return shapeIndex < 0 
          ? [209/255, 237/255, 247/255, 1] 
          : precomputedPaths[shapeIndex]?.color || [1, 1, 1, 1];
      }

      const progress = (time - transition.startTime) / (colorTransitionConfig.changeInterval * 1000);

      // 目標色変更のタイミング（シーケンスベース）
      if (progress >= 1.0) {
        transition.currentColor = [...transition.targetColor];
        
        // 次のシーケンスステップに進む（各図形独立して進む）
        if (typeof transition.sequenceStep !== 'number') {
          transition.sequenceStep = 0;
        }
        transition.sequenceStep = (transition.sequenceStep + 1) % colorTransitionConfig.sequenceLength;
        const nextStepColors = colorSequence[transition.sequenceStep];
        
        // sin波ベースの色変化を目標色として使用
        const colorSpeed = config.animation.colorSpeed;
        const intensity = 0.3; // より強い変化
        const baseThemeColor = shapeIndex < 0 
          ? [209/255, 237/255, 247/255, 1] 
          : precomputedPaths[shapeIndex]?.color || [1, 1, 1, 1];
          
        transition.targetColor = [
          Math.max(0, Math.min(1, baseThemeColor[0] + intensity * Math.sin(time * colorSpeed + shapeIndex))),
          Math.max(0, Math.min(1, baseThemeColor[1] + intensity * Math.sin(time * colorSpeed * 1.2 + shapeIndex + 1))),
          Math.max(0, Math.min(1, baseThemeColor[2] + intensity * Math.sin(time * colorSpeed * 0.8 + shapeIndex + 2))),
          1.0,
        ];
        
        console.log(`Shape ${shapeIndex} targeting sin-wave color:`, transition.targetColor);
        
        transition.startTime = time;
      }

      // 線形補間で色を遷移
      const t = Math.min(progress, 1.0);
      const smoothT = t * t * (3.0 - 2.0 * t); // smoothstep関数で滑らかに

      const result = [
        transition.currentColor[0] + (transition.targetColor[0] - transition.currentColor[0]) * smoothT,
        transition.currentColor[1] + (transition.targetColor[1] - transition.currentColor[1]) * smoothT,
        transition.currentColor[2] + (transition.targetColor[2] - transition.currentColor[2]) * smoothT,
        1.0,
      ];

      return result;
    }

    /**
     * 色遷移システムの初期化（シーケンスベース）
     */
    initColorTransitions() {
      this.colorTransitions = [];
      
      const pathCount = precomputedPaths.length;
      
      for (let i = 0; i <= pathCount; i++) { // +1は楕円用
        // 初期色は事前計算された色を使用
        const currentColor = i < pathCount 
          ? [...precomputedPaths[i].color] 
          : [209/255, 237/255, 247/255, 1]; // 楕円の初期色
          
        // 次のステップの色をシーケンスから取得
        const initialStep = Math.floor(Math.random() * colorTransitionConfig.sequenceLength);
        const nextColor = colorSequence[initialStep] && colorSequence[initialStep][i] 
          ? [...colorSequence[initialStep][i]] 
          : this.getRandomThemeColor(); // フォールバック
          
        this.colorTransitions[i] = {
          currentColor: currentColor,
          targetColor: nextColor,
          startTime: Math.random() * colorTransitionConfig.changeInterval * 1000, // ミリ秒に変換
          sequenceStep: initialStep, // 各図形独立したステップ
        };
      }
    }

    /**
     * テーマからランダムな色を取得
     * @returns {number[]}
     */
    getRandomThemeColor() {
      if (selectedTheme === "random") {
        return [Math.random(), Math.random(), Math.random(), 1];
      }
      const themeColors = colorThemes[selectedTheme];
      return [...themeColors[Math.floor(Math.random() * themeColors.length)]];
    }

    // generateRandomColor関数は不要（色はフロントマターで定義済み）
  }

  // 設定変数
  const config = {
    // アニメーション設定
    animation: {
      vertexSpeed: 0.8, // 頂点アニメーション速度
      colorSpeed: 1.5, // 色変化速度
      transformSpeed: 0.3, // 変形速度
    },
    // ブラー設定
    blur: {
      intensity: 64.0, // ブラー強度（sigma値）
      kernelSize: 31, // カーネルサイズ
    },
  };

  const api = new WebGLAPI(gl);

  // シェーダー作成（外部化されたシェーダーコードを使用）
  const vertexShaderSource = shaders.vertex;
  const fragmentShaderSource = shaders.fragment;

  // ポストエフェクト用のシェーダー（外部化されたシェーダーコードを使用）
  const postVertexShaderSource = shaders.postVertex;
  const postFragmentShaderSource = shaders.postFragment;

  // 背景用のシェーダー（外部ファイルから読み込み）
  const backgroundVertexShaderSource = shaders.backgroundVertex;
  const backgroundFragmentShaderSource = shaders.backgroundFragment;

  // メインレンダリング用シェーダー
  const vertexShader = api.createShader(gl.VERTEX_SHADER, vertexShaderSource);
  const fragmentShader = api.createShader(gl.FRAGMENT_SHADER, fragmentShaderSource);
  const { program, locations: mainLoc } = api.createProgramWithLocations(
    [vertexShader, fragmentShader],
    ["a_position"],
    ["u_resolution", "u_color"],
  );

  // ポストエフェクト用シェーダー
  const postVertexShader = api.createShader(gl.VERTEX_SHADER, postVertexShaderSource);
  const postFragmentShader = api.createShader(gl.FRAGMENT_SHADER, postFragmentShaderSource);
  const { program: postProgram, locations: postLoc } = api.createProgramWithLocations(
    [postVertexShader, postFragmentShader],
    ["a_position"],
    ["u_image", "u_textureSize", "u_direction", "u_kernel[0]"],
  );

  // 背景用シェーダー
  const backgroundVertexShader = api.createShader(gl.VERTEX_SHADER, backgroundVertexShaderSource);
  const backgroundFragmentShader = api.createShader(gl.FRAGMENT_SHADER, backgroundFragmentShaderSource);
  const { program: backgroundProgram, locations: backgroundLoc } = api.createProgramWithLocations(
    [backgroundVertexShader, backgroundFragmentShader],
    ["a_position"],
    ["u_time", "u_resolution"],
  );

  // バッファ作成
  const positionBuffer = api.createBuffer(new Float32Array([])); // 空で初期化
  const quadBuffer = api.createBuffer(new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]));

  // 2パス処理用のテクスチャとフレームバッファ
  const texture1 = api.createTexture(canvasWidth, canvasHeight);
  const framebuffer1 = api.createFramebuffer(texture1);

  const texture2 = api.createTexture(canvasWidth, canvasHeight);
  const framebuffer2 = api.createFramebuffer(texture2);

  // レンダラー初期化
  api.initRenderer(canvasWidth, canvasHeight);

  // メインプログラム使用
  gl.useProgram(program);
  gl.uniform2f(mainLoc.u_resolution, canvasWidth, canvasHeight);

  // drawShape関数はWebGLAPIクラスに移動

  // parseSVGPath関数は事前計算で使用済みのため削除（precomputedPathsを使用）

  // 楕円描画（事前計算済みを使用）
  api.drawShape(
    precomputedEllipse,
    [209 / 255, 237 / 255, 247 / 255, 1],
    { scale: 1, translateX: 0, translateY: 0 },
    positionBuffer,
    mainLoc,
  );

  // アニメーション用変数
  let startTime = performance.now();
  let animationId;

  // animateVertices、animateColors関数はWebGLAPIクラスに移動

  function animate(currentTime) {
    const elapsed = (currentTime - startTime) / 1000; // 秒

    // Step 1: 元の図形をフレームバッファ1に描画
    gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer1);
    gl.viewport(0, 0, canvasWidth, canvasHeight);

    // 動的背景を描画
    gl.useProgram(backgroundProgram);
    gl.uniform1f(backgroundLoc.u_time, elapsed);
    gl.uniform2f(backgroundLoc.u_resolution, canvasWidth, canvasHeight);

    gl.bindBuffer(gl.ARRAY_BUFFER, quadBuffer);
    gl.enableVertexAttribArray(backgroundLoc.a_position);
    gl.vertexAttribPointer(backgroundLoc.a_position, 2, gl.FLOAT, false, 0, 0);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

    // メインプログラム使用
    gl.useProgram(program);
    gl.uniform2f(mainLoc.u_resolution, canvasWidth, canvasHeight);

    // 楕円描画（静的）
    const animatedEllipse = precomputedEllipse; // 静的
    const ellipseColor = api.animateColors(null, elapsed, -1, config);
    api.drawShape(animatedEllipse, ellipseColor, { scale: 1, translateX: 0, translateY: 0 }, positionBuffer, mainLoc);

    // 各パスをアニメーション付きで描画
    precomputedPaths.forEach((path, index) => {
      const originalVertices = path.vertices;
      // 静的な図形（なおった時点）
      const animatedVertices = originalVertices;
      // baseColorパラメータは使用せず、完全に独立した色遷移システム
      const animatedColor = api.animateColors(null, elapsed, index, config);

      // transform をより大胆に動かす
      const animatedTransform = {
        ...path.transform,
        translateX: path.transform.translateX + 15 * Math.sin(elapsed * config.animation.transformSpeed + index * 1.5),
        translateY:
          path.transform.translateY + 12 * Math.cos(elapsed * config.animation.transformSpeed * 1.3 + index * 1.2),
        rotation: path.transform.rotation
          ? path.transform.rotation + 0.3 * Math.sin(elapsed * config.animation.transformSpeed * 0.7 + index)
          : 0.2 * Math.sin(elapsed * config.animation.transformSpeed * 0.8 + index),
      };

      api.drawShape(animatedVertices, animatedColor, animatedTransform, positionBuffer, mainLoc);
    });

    // Step 2: 横方向ブラー（フレームバッファ1→フレームバッファ2）
    gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer2);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.useProgram(postProgram);
    gl.uniform2f(postLoc.u_textureSize, canvasWidth, canvasHeight);
    gl.uniform1i(postLoc.u_direction, 0); // 横方向
    gl.uniform1fv(postLoc["u_kernel[0]"], precomputedKernel);

    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, texture1);
    gl.uniform1i(postLoc.u_image, 0);

    gl.bindBuffer(gl.ARRAY_BUFFER, quadBuffer);
    gl.enableVertexAttribArray(postLoc.a_position);
    gl.vertexAttribPointer(postLoc.a_position, 2, gl.FLOAT, false, 0, 0);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

    // Step 3: 縦方向ブラー（フレームバッファ2→画面）
    gl.bindFramebuffer(gl.FRAMEBUFFER, null);
    gl.viewport(0, 0, canvasWidth, canvasHeight);

    // 最終出力の動的背景を描画
    gl.useProgram(backgroundProgram);
    gl.uniform1f(backgroundLoc.u_time, elapsed);
    gl.uniform2f(backgroundLoc.u_resolution, canvasWidth, canvasHeight);

    gl.bindBuffer(gl.ARRAY_BUFFER, quadBuffer);
    gl.enableVertexAttribArray(backgroundLoc.a_position);
    gl.vertexAttribPointer(backgroundLoc.a_position, 2, gl.FLOAT, false, 0, 0);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

    // ポストエフェクトを適用
    gl.useProgram(postProgram);
    gl.uniform2f(postLoc.u_textureSize, canvasWidth, canvasHeight);
    gl.uniform1i(postLoc.u_direction, 1); // 縦方向

    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, texture2);
    gl.uniform1i(postLoc.u_image, 0);

    gl.bindBuffer(gl.ARRAY_BUFFER, quadBuffer);
    gl.enableVertexAttribArray(postLoc.a_position);
    gl.vertexAttribPointer(postLoc.a_position, 2, gl.FLOAT, false, 0, 0);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);

    animationId = requestAnimationFrame(animate);
  }

  // アニメーション開始
  startTime = performance.now();
  requestAnimationFrame(animate);

  // ページ離脱時にアニメーション停止
  window.addEventListener("beforeunload", () => {
    if (animationId) {
      cancelAnimationFrame(animationId);
    }
  });
</script>
