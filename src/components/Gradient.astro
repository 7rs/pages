import { loadAllShaders } from "@scripts/graphic/shader-loader.ts";
import {
  parseSVGPathStatic,
  generateGaussianKernel,
  generateEllipseVertices,
} from "@scripts/graphic/precompute-utils.ts";
import type { Path } from "@scripts/graphic/types.d.ts";

export interface Props {
  className?: string;
}
const { className = "", ...props } = Astro.props;

const shaders = loadAllShaders();

// 色テーマ定義
const colorThemes = {
  dracula: [
    [1.0, 0.475, 0.776, 1],    // #ff79c6 ピンク
    [0.741, 0.576, 0.976, 1],  // #bd93f9 紫
    [1.0, 0.722, 0.424, 1],    // #ffb86c オレンジ
    [0.255, 0.271, 0.345, 1],  // #414558 ダークグレー
    [0.839, 0.843, 0.859, 1],  // #d6d7db ライトグレー
    [0.157, 0.165, 0.212, 1],  // #282a36 ダークブルー
    [0.545, 0.914, 0.992, 1],  // #8be9fd シアン
    [0.318, 0.980, 0.482, 1],  // #51fa7b 緑
    [0.945, 0.980, 0.549, 1],  // #f1fa8c 黄
    [1.0, 0.333, 0.333, 1],    // #ff5555 赤
  ],
  random: [
    [Math.random(), Math.random(), Math.random(), 1],
    [Math.random(), Math.random(), Math.random(), 1],
    [Math.random(), Math.random(), Math.random(), 1],
    [Math.random(), Math.random(), Math.random(), 1],
  ],
};

// 使用する色テーマを選択（ここで変更可能）
const selectedTheme = "dracula";

// テーマからランダムに色を選択する関数
function getRandomThemeColor(theme: string, usedColors: number[][] = []): number[] {
  if (theme === "random") {
    return [Math.random(), Math.random(), Math.random(), 1];
  }
  
  const themeColors = colorThemes[theme];
  const availableColors = themeColors.filter(color => 
    !usedColors.some(used => 
      Math.abs(used[0] - color[0]) < 0.01 && 
      Math.abs(used[1] - color[1]) < 0.01 && 
      Math.abs(used[2] - color[2]) < 0.01
    )
  );
  
  // 使用可能な色がない場合は全色から選択
  const colorsToChooseFrom = availableColors.length > 0 ? availableColors : themeColors;
  return [...colorsToChooseFrom[Math.floor(Math.random() * colorsToChooseFrom.length)]];
}

// パス用の色をランダム選択（重複回避）
const pathColors: number[][] = [];
for (let i = 0; i < 4; i++) {
  pathColors.push(getRandomThemeColor(selectedTheme, pathColors));
}

// 事前生成された色遷移シーケンス（30ステップ分）
function generateColorSequence(theme: string, pathCount: number, sequenceLength: number = 30): number[][][] {
  const sequence: number[][][] = [];
  const themeColors = colorThemes[theme];
  
  if (!themeColors && theme !== "random") {
    console.warn(`Theme "${theme}" not found, using random colors`);
    theme = "random";
  }
  
  // 初期色設定（重複なし）
  let currentColors: number[][] = [];
  for (let i = 0; i < pathCount + 1; i++) { // +1は楕円用
    let newColor: number[];
    let attempts = 0;
    do {
      newColor = theme === "random" 
        ? [Math.random(), Math.random(), Math.random(), 1]
        : [...themeColors[Math.floor(Math.random() * themeColors.length)]];
      attempts++;
    } while (
      attempts < 50 && 
      currentColors.some(color => 
        Math.abs(color[0] - newColor[0]) < 0.01 && 
        Math.abs(color[1] - newColor[1]) < 0.01 && 
        Math.abs(color[2] - newColor[2]) < 0.01
      )
    );
    currentColors.push(newColor);
  }
  
  // 各図形の色履歴を管理（直近3ステップ）
  const colorHistory: number[][][] = [];
  for (let i = 0; i < pathCount + 1; i++) {
    colorHistory[i] = [currentColors[i]]; // 初期色を履歴に追加
  }
  
  // シーケンス生成
  for (let step = 0; step < sequenceLength; step++) {
    const nextColors: number[][] = [];
    const usedInThisStep: number[][] = [];
    
    for (let shapeIndex = 0; shapeIndex < pathCount + 1; shapeIndex++) {
      let newColor: number[];
      let attempts = 0;
      
      do {
        newColor = theme === "random" 
          ? [Math.random(), Math.random(), Math.random(), 1]
          : [...themeColors[Math.floor(Math.random() * themeColors.length)]];
        attempts++;
      } while (
        attempts < 100 && (
          // 直近3ステップの色と同じものを避ける
          colorHistory[shapeIndex].some(historyColor => 
            Math.abs(historyColor[0] - newColor[0]) < 0.01 && 
            Math.abs(historyColor[1] - newColor[1]) < 0.01 && 
            Math.abs(historyColor[2] - newColor[2]) < 0.01
          ) ||
          // 同時刻の他の図形と同じ色を避ける
          usedInThisStep.some(color => 
            Math.abs(color[0] - newColor[0]) < 0.01 && 
            Math.abs(color[1] - newColor[1]) < 0.01 && 
            Math.abs(color[2] - newColor[2]) < 0.01
          )
        )
      );
      
      nextColors.push(newColor);
      usedInThisStep.push(newColor);
      
      // 色履歴を更新（直近3ステップまで保持）
      colorHistory[shapeIndex].push(newColor);
      if (colorHistory[shapeIndex].length > 3) {
        colorHistory[shapeIndex].shift(); // 古い履歴を削除
      }
    }
    
    sequence.push([...nextColors]);
    currentColors = nextColors;
  }
  
  // デバッグ用: 最初の5ステップをコンソール出力
  console.log("Generated color sequence (first 5 steps):");
  for (let step = 0; step < Math.min(5, sequence.length); step++) {
    console.log(`Step ${step}:`, sequence[step].map(color => 
      `[${color[0].toFixed(2)}, ${color[1].toFixed(2)}, ${color[2].toFixed(2)}]`
    ));
  }
  
  return sequence;
}

// 色遷移シーケンスを事前生成
const colorSequence = generateColorSequence(selectedTheme, 4, 30);

// 色遷移用の初期設定
const colorTransitionConfig = {
  enableTransition: true,        // 色遷移を有効にするか
  transitionSpeed: 0.25,         // 遷移速度（低いほど遅い）
  changeInterval: 1.0,          // 目標色変更間隔（秒）- デバッグ用に短縮
  sequenceLength: 60,           // シーケンスの長さ
};

// 事前計算（統合オブジェクト）
const precomputedPaths: Path[] = [
  {
    vertices: parseSVGPathStatic(
      "M20,-4.3C35.9,-4.1,65.7,-2.1,74.2,8.5C82.7,19.1,70,38.2,54.1,40.8C38.2,43.3,19.1,29.4,7.6,21.8C-3.9,14.2,-7.7,12.9,-13.4,10.3C-19.1,7.7,-26.7,3.9,-36,-9.3C-45.3,-22.5,-56.4,-45,-50.7,-45.2C-45,-45.3,-22.5,-23,-10.2,-12.7C2.1,-2.5,4.1,-4.4,20,-4.3Z",
    ),
    color: pathColors[0],
    transform: { scale: 5, translateX: 128, translateY: 448 },
  },
  {
    vertices: parseSVGPathStatic(
      "M32,-40.6C32.1,-32,16.1,-16,19.9,3.8C23.7,23.6,47.2,47.1,47.1,59.3C47.1,71.6,23.6,72.4,6.5,66C-10.7,59.5,-21.3,45.8,-35.9,33.5C-50.5,21.3,-69,10.7,-74.3,-5.3C-79.5,-21.2,-71.5,-42.3,-56.9,-50.9C-42.3,-59.5,-21.2,-55.5,-2.6,-52.9C16,-50.3,32,-49.1,32,-40.6Z",
    ),
    color: pathColors[1],
    transform: { scale: 5, translateX: 960, translateY: 128 },
  },
  {
    vertices: parseSVGPathStatic(
      "M48.3,-52.3C55.2,-41.4,48.5,-20.7,41.2,-7.2C34,6.2,26.3,12.4,19.3,24C12.4,35.7,6.2,52.8,-5.5,58.3C-17.3,63.9,-34.6,57.9,-50.3,46.2C-66,34.6,-80.2,17.3,-71.7,8.5C-63.3,-0.3,-32.1,-0.6,-16.3,-11.6C-0.6,-22.5,-0.3,-44.2,10.2,-54.4C20.7,-64.6,41.4,-63.3,48.3,-52.3Z",
    ),
    color: pathColors[2],
    transform: { scale: 10, translateX: 960, translateY: 704 },
  },
  {
    vertices: parseSVGPathStatic(
      "M59.7,-62.3C72.6,-46.8,74.9,-23.4,64.6,-10.3C54.3,2.8,31.4,5.6,18.5,11.1C5.6,16.6,2.8,24.7,-3.7,28.3C-10.2,32,-20.4,31.3,-21.9,25.8C-23.4,20.4,-16.4,10.2,-21.1,-4.8C-25.9,-19.7,-42.5,-39.4,-40.9,-54.9C-39.4,-70.4,-19.7,-81.7,1.9,-83.6C23.4,-85.5,46.8,-77.9,59.7,-62.3Z",
    ),
    color: pathColors[3],
    transform: { scale: 4, translateX: 64, translateY: 960, rotation: (-30 * Math.PI) / 180 },
  },
];

const precomputedEllipse = generateEllipseVertices(256, 256, 512, 512, 100);
const precomputedKernel = generateGaussianKernel(31, 64.0);
