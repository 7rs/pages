---
import Description from "@components/landing/Description.astro";
import LandingSection from "@components/landing/LandingSection.astro";
import RingContent from "@components/landing/RingContent.astro";
import Tab from "@components/Tab.astro";
import TabList from "@components/TabList.astro";

import { MarkdownString, MarkdownStringObject } from "@scripts/markdown.ts";
---

<LandingSection
  title="What does this website have?"
  titleClassName="text-end from-emerald-500 to-[var(--color-base-content)]/50"
>
  <TabList>
    <Tab tabName="Ultimate Fast" icon="line-md:speed-loop" checked>
      <RingContent
        mainText="Ultimate Fast"
        subText="The All for Speed"
        items={[
          {
            name: "Performance",
            description: MarkdownString(
              "Amazing fast contents",
              "by [Cloudflare](https://www.cloudflare.com/) and [Astro](https://astro.build/).",
            ),
            icon: "material-symbols:rocket-launch-outline-rounded",
          },
          {
            name: "Optimizations",
            description: "Minimum bundle size and compressed assets.",
            icon: "material-symbols:compress-rounded",
          },
          {
            name: "JavaScript",
            description: MarkdownString(
              "JS code are minimum",
              "by [UnoCSS](https://unocss.dev/) and [Astro](https://astro.build/).",
            ),
            icon: "line-md:light-dark-loop",
          },
          {
            name: "Ultimate SSG",
            description: "Dynamically generated components and CSS are minimal.",
            icon: "line-md:cloud-alt-print-loop",
          },
          { name: "Search", description: "Blazing fast search by Rust implementations.", icon: "line-md:search" },
        ]}
        useLinearGradient
        reverseLinearDirection
        catchCopyClassNames="from-white to-[var(--color-base-content)]/60"
      />
    </Tab>

    <Tab tabName="User-friendly" icon="line-md:emoji-smile-wink">
      <RingContent
        mainText="User-Friendly"
        subText="Without sacrificing usability"
        items={[
          {
            name: "Compatibility",
            description: "Supports modern browser and many devices.",
            icon: "simple-icons:cloudflare",
          },
          {
            name: "Low-transfer",
            description: MarkdownString("Dark theme without JS", "by [UnoCSS](https://unocss.dev/)."),
            icon: "material-symbols:compress-rounded",
          },
          {
            name: "Security",
            description: MarkdownString(
              "High accessibility",
              "by [Iconify's icons](https://iconify.design/) and [daisyUI](https://daisyui.com/) components.",
            ),
            icon: "material-symbols:shield-lock-outline-rounded",
          },
          { name: "Free", description: "No ads, No marketing, No paid.", icon: "material-symbols:money-off-rounded" },
          { name: "Any device", description: "", icon: "material-symbols:devices-outline-rounded" },
        ]}
        useLinearGradient
        catchCopyClassNames="from-white to-[var(--color-base-content)]/60"
      />
    </Tab>

    <Tab tabName="For Developers" icon="material-symbols:code-rounded">
      <RingContent
        mainText="For Developers"
        subText="Contribute or Use"
        items={[
          {
            name: "CC0",
            description: MarkdownString("Distributed under the [CC0](https://creativecommons.org/public-domain/cc0/)."),
            icon: "cib:creative-commons-zero",
          },
          {
            name: "Experience",
            description: MarkdownString(
              "Used ESM,",
              "[TypeScript (strict)](https://www.typescriptlang.org/) and [Oxlint](https://oxc.rs/docs/guide/usage/linter).",
            ),
            icon: "simple-icons:bun",
          },
          { name: "Tools", description: "Tools by compiled languages implementations.", icon: "simple-icons:rust" },
          {
            name: "TypeScript",
            description: MarkdownString(
              "Most code is written in simple frameworks",
              "such as [Astro](https://astro.build/) and [Svelte](https://svelte.dev/).",
            ),
            icon: "simple-icons:typescript",
          },
          { name: "Global", description: "", icon: "material-symbols:groups" },
        ]}
        useLinearGradient
        catchCopyClassNames="from-[var(--color-base-content)]/50 via-white to-[var(--color-base-content)]/50"
      />
    </Tab>
  </TabList>
</LandingSection>
