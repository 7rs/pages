---
import Description from "@components/Description.astro";
import LandingSection from "@components/LandingSection.astro";
import RingContent from "@components/RingContent.astro";
import Tab from "@components/Tab.astro";
import TabList from "@components/TabList.astro";
---

<LandingSection title="What does Pages have?" titleClassName="text-end from-emerald-500 to-[var(--color-base-content)]/50">
  <TabList>
    <Tab tabName="Pages Blog" icon="material-symbols:article-outline" checked>
      <RingContent
        mainText="Pages Blog"
        subText="Readable and Usable"
        icons={[
          { name: "material-symbols:search-rounded", alt: "Search" },
          { name: "mdi:comment-multiple-outline", alt: "Comments/Chat" },
          { name: "line-md:light-dark-loop", alt: "Dark Mode" },
          { name: "mdi:share-variant", alt: "Share" },
          { name: "material-symbols:translate-rounded", alt: "Multi Language" },
        ]}
      >
        <Description title="Search" icon="material-symbols:search-rounded">
          "Pagefind" written in Rust is amazing fast and, only requires once hydration.
        </Description>
        <Description title="Comments" icon="mdi:comment-multiple-outline"> Not planned </Description>
        <Description title="Dark Mode" icon="line-md:light-dark-loop">
          Used emerald for the light theme and dracula for the dark theme. You can change the theme without JS!
        </Description>
        <Description title="Share" icon="mdi:share-variant">
          URLs can be copied unrelated to your device, and can be share to SNS.
        </Description>
        <Description title="i18n" icon="material-symbols:translate-rounded">
          Japanese and English are supported. Also, you can translate the website with Google Translate.
        </Description>
      </RingContent>
    </Tab>

    <Tab tabName="7rs.dev" icon="mdi:lightning-bolt">
      <RingContent
        mainText="7rs.dev"
        subText="Without the stress"
        icons={[
          { name: "simple-icons:cloudflare", alt: "Low-latency" },
          { name: "material-symbols:compress-rounded", alt: "Low-transfer" },
          { name: "material-symbols:shield-lock-outline-rounded", alt: "Security" },
          { name: "material-symbols:money-off-rounded", alt: "Free" },
          { name: "material-symbols:devices-outline-rounded", alt: "Any device" },
        ]}
      >
        <Description title="Low-latency" icon="simple-icons:cloudflare">
          By HTTP/3 (QUIC), CDN, Caches, Rocket Loader and Cloudflare Pages etc.
        </Description>
        <Description title="Low-transfer" icon="material-symbols:compress-rounded">
          By FontSource, Sharp, Brotil and PurgeCSS etc.
        </Description>
        <Description title="Security" icon="material-symbols:shield-lock-outline-rounded">
          By HTTP/3 (QUIC), DNSSEC, HSTS. Also, it partially works without JavaScript.
        </Description>
        <Description title="Free" icon="material-symbols:money-off-rounded">
          No paid content, No ads and No login. Only need a browser.
        </Description>
        <Description title="Any device" icon="material-symbols:devices-outline-rounded">
          You can use any device! Oops, except for Internet Explorer.
        </Description>
      </RingContent>
    </Tab>

    <Tab tabName="7rs/pages" icon="cib:creative-commons-zero">
      <RingContent
        mainText="Pages Project"
        subText="FLOSS and Modern"
        icons={[
          { name: "cib:creative-commons-zero", alt: "CC0" },
          { name: "simple-icons:bun", alt: "Experience" },
          { name: "simple-icons:rust", alt: "Tools" },
          { name: "simple-icons:typescript", alt: "TypeScript" },
          { name: "material-symbols:groups", alt: "Global" },
        ]}
      >
        <Description title="CC0" icon="cib:creative-commons-zero">
          CC0 is the least restrictive and no copyleft.
        </Description>
        <Description title="Experience" icon="simple-icons:bun">
          This project is developed for Bun and, I'm using Nushell. So amazing fast development experience on Windows!
        </Description>
        <Description title="Tools" icon="simple-icons:rust">
          Used Oxlint (Faster than ESLint) and Biome (Faster than Prettier).
        </Description>
        <Description title="Share" icon="simple-icons:typescript">
          Actively uses ESModule and TypeScript. In other words, developers will fight linters, not an invisible enemy.
        </Description>
        <Description title="Global" icon="material-symbols:groups">
          Used only English. All people can contribute.
        </Description>
      </RingContent>
    </Tab>
  </TabList>
</LandingSection>
