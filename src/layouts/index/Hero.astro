---
import Anchor from "@components/Anchor.astro";
---

<section class="h-svh | flex flex-col justify-center items-center gap-y-4">
  <hgroup class="flex flex-col justify-center gap-y-2 | text-center">
    <h2 class="text-3xl md:text-5xl font-bold">Fast, Lean and Customizable!</h2>
    <p>
      A FLOSS website for all visitors and all developers🤩 Astro maximizes performance, UnoCSS removes styling
      complexity, and daisyUI helps creating UIs. Enjoy the new world!
    </p>
  </hgroup>
  <div class="flex justify-center gap-x-4">
    <Anchor class="btn btn-soft btn-primary" href="https://github.com/7rs/pages">Source code</Anchor>
    <Anchor class="btn btn-soft btn-primary" href="#what-the-modern-website?" openAsNew={false}>Learn more</Anchor>
  </div>
</section>
