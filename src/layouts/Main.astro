---
import Head from "@layouts/Head.astro";
import Header from "@layouts/Header.astro";
import Footer from "@layouts/Footer.astro";

import "@unocss/reset/tailwind.css";
import "uno.css";
import "@styles/index.scss";
---

<html>
  <Head />
  <body class="min-h-dvh w-full grid grid-rows-[auto_1fr_auto] bg-base-200">
    <Header>7rs.dev</Header>
    <main>
      <slot />
    </main>
    <Footer
      navigations={[
        { url: "/", label: "Main" },
        { url: "/blog", label: "Blog" },
        { url: "/license", label: "License" },
      ]}
      socials={[
        {url: "https://youtube.com/@qRze", icon: "simple-icons:youtube", color: "#ff0000"},
        {url: "https://7rs.dev/d", icon: "simple-icons:discord"},
        {url: "https://github.com/7rs", icon: "simple-icons:github"},
        {url: "https://zenn.dev/7rs", icon: "simple-icons:zenn"},
        {url: "https://patreon.com/7rs", icon: "simple-icons:patreon"},
        {url: "/", icon: "simple-icons:rss"},
      ]}
    />
  </body>
</html>
