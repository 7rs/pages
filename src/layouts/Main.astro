---
import Base from "@layouts/Base.astro";

export interface Props {
  title?: string;
  className?: string;
  lang?: string;
  showFakeHeader?: boolean;
}

const { title = "No title", className = "", lang, showFakeHeader, ...props } = Astro.props;
---

<Base title={title} lang={lang} showFakeHeader={showFakeHeader}>
  <div class:list={["max-w-svw main:max-w-main w-full", className]} {...props}>
    <slot />
  </div>
</Base>
