---
import Head from "@layouts/Head.astro";
import Header from "@layouts/Header.astro";
import Footer from "@layouts/Footer.astro";

/* eslint-disable */
import "@unocss/reset/tailwind.css";
import "uno.css";
/* eslint-enable */

import "@styles/index.scss";

interface Props {
  title: string;
  className?: string;
  showFakeHeader?: boolean;
}

const { title, className = "", showFakeHeader } = Astro.props;
---

<html>
  <Head title={title} />
  <body class="min-h-dvh w-full | grid grid-rows-[auto_1fr_auto] | bg-base-200">
    <Header showFakeHeader={showFakeHeader}>
      <h1 class="text-3xl font-bold">7rs.dev</h1>
    </Header>
    <main class="w-full flex justify-center">
      <div class:list={["px-2 lg:px-0 min-[900px]:mx-0 max-w-[900px] w-full", className]}>
        <slot />
      </div>
    </main>
    <Footer
      navigations={[
        { url: "/", label: "Main" },
        { url: "/blog", label: "Blog" },
        { url: "/license", label: "License" },
      ]}
      socials={[
        { url: "https://youtube.com/@qRze", icon: "simple-icons:youtube" },
        { url: "https://7rs.dev/d", icon: "simple-icons:discord" },
        { url: "https://github.com/7rs", icon: "simple-icons:github" },
        { url: "https://zenn.dev/7rs", icon: "simple-icons:zenn" },
        { url: "https://patreon.com/7rs", icon: "simple-icons:patreon" },
        { url: "/", icon: "simple-icons:rss" },
      ]}
    />
  </body>
</html>
