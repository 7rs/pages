---
import ThemeButton from "@/components/ThemeButton.astro";

export interface Props {
  icon?: string;
}

const { icon } = Astro.props;
---

<header class="fixed top-0 z-999 | w-full | flex justify-center | bg-base-100 shadow-sm">
  <div class="navbar | px-4 max-w-[900px]">
    <a class="flex-1" href="/" title="main page">
      <slot />
    </a>
    <div class="flex-none flex text-2xl">
      <ThemeButton />
    </div>
  </div>
</header>
