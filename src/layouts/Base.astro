---
import Head from "@layouts/_common/Head.astro";
import Header from "@layouts/_common/Header.astro";
import Footer from "@layouts/_common/Footer.astro";

/* eslint-disable */
import "@unocss/reset/tailwind.css";
import "uno.css";
/* eslint-enable */

import "@styles/index.scss";

export interface Props {
  title?: string;
  lang?: string;
  showFakeHeader?: boolean;
  showHero?: boolean;
  showSidebar?: boolean;
  mainClassName?: string;
  noIndex?: boolean;
}

const {
  title = "No title",
  lang,
  showFakeHeader,
  showHero = false,
  showSidebar = false,
  mainClassName = "",
  noIndex = false,
} = Astro.props;
---

<html lang={lang}>
  <Head title={title} noIndex={noIndex} />
  <body
    class="min-h-dvh w-full relative | grid grid-cols-[100%] grid-rows-[auto_1fr_auto] place-items-center bg-base-200"
    data-show-hero={showHero}
  >
    <!-- grid-area: header -->
    <Header showFakeHeader={showFakeHeader}>
      <h1 class="text-3xl font-bold">7rs.dev</h1>
    </Header>

    <!-- grid-area: hero -->
    {
      showHero && (
        <section class="grid-area-[hero]">
          <slot name="hero" />
        </section>
      )
    }

    <!-- grid-area: main -->
    <main
      class:list={[
        "grid-area-[main] relative | px-4 h-full w-full | flex gap-x-2rem justify-center",
        showSidebar ? "xl:max-w-2xl" : "lg:max-w-lg",
        mainClassName,
      ]}
    >
      <slot />
      {
        showSidebar && (
          <section class="grow xl:min-w-4xs xl:max-w-3xs | hidden xl:flex flex place-items-initial items-initial">
            <slot name="sidebar" />
          </section>
        )
      }
    </main>

    <!-- grid-area: footer -->
    <Footer
      navigations={[
        { url: "/", label: "Main" },
        { url: "/blog", label: "Blog" },
        { url: "/license", label: "License" },
      ]}
      socials={[
        { url: "https://youtube.com/@qRze", icon: "simple-icons:youtube" },
        { url: "https://7rs.dev/d", icon: "simple-icons:discord" },
        { url: "https://github.com/7rs", icon: "simple-icons:github" },
        { url: "https://zenn.dev/7rs", icon: "simple-icons:zenn" },
        { url: "https://patreon.com/7rs", icon: "simple-icons:patreon" },
        { url: "/", icon: "simple-icons:rss" },
      ]}
    />
  </body>
</html>
