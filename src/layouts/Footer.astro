---
import AnimatedAnchor from "@/components/AnimatedAnchor.astro";
import LinkIcon from "@/components/LinkIcon.astro";
import { Icon } from "astro-icon/components";

interface Navigation {
  url: string;
  label: string;
}

interface Social {
  url: string;
  icon: string;
  color?: string;
}

export interface Props {
  navigations?: Navigation[];
  socials?: Social[];
}

const { navigations = [], socials = [] } = Astro.props;
---

<footer
  class="self-end justify-self-end footer footer-horizontal footer-center bg-base-100 text-base-content rounded p-10"
>
  <nav class="w-full flex flex-wrap justify-center gap-x-4 md:gap-x-8">
    {navigations.map((nav) => <AnimatedAnchor href={nav.url}>{nav.label}</AnimatedAnchor>)}
  </nav>

  <nav class="w-full flex flex-wrap justify-around md:justify-center md:gap-x-8">
    {socials.map((social) => <LinkIcon href={social.url} icon={social.icon} color={social.color} />)}
  </nav>

  <p class="text-base inline">
    No copyright <Icon class="inline" name="cib:creative-commons-zero" />
    {new Date().getFullYear()} - No right reserved except for things that not made by me.
  </p>
</footer>
