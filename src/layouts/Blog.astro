---
import type { Blog as BlogFrontmatter } from "@content/config";
import type { Props as MainProps } from "@layouts/Main.astro";
import Main from "@layouts/Main.astro";

interface Props extends MainProps {
  frontmatter?: BlogFrontmatter;
}

const { frontmatter, ...props } = Astro.props;
---

<Main
  title={frontmatter.title || "No title"}
  className="my-4 !min-[700px]:max-w-[700px]"
  data-content-type="md"
  {...props}
>
  <div>
    <p>{frontmatter.title}</p>
    <p class="flex gap-x-2">
      {frontmatter.tags.map((tag) => <span>#{tag}</span>)}
    </p>
    <p class="flex gap-x-2">
      {frontmatter.authors.map((author) => <span>@{author}</span>)}
    </p>
    <p>{frontmatter.created}</p>
  </div>
  <slot />
</Main>
