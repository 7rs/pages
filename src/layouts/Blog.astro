---
import type { MarkdownHeading } from "astro";
import Base from "@layouts/Base.astro";
import type { Props as MainProps } from "@layouts/Main.astro";
import BlogHeader from "@layouts/blog/BlogHeader.astro";
import type { Blog as BlogFrontmatter } from "@content/config";
import Anchor from "@components/Anchor.astro";
import TableOfContents from "@layouts/blog/TableOfContents.astro";

interface Props extends MainProps {
  frontmatter?: BlogFrontmatter;
  headings?: MarkdownHeading[];
  lang?: string;
  slug?: string;
  length?: number;
}

const { frontmatter = {}, headings, lang, slug, length, ...props } = Astro.props;
const title = frontmatter.title || "No title";

// mainClassName="!lg:min-w-[600px] !lg:max-w-[700px]"
---

<Base title={title} lang={lang} showFakeHeader={false} showHero showSidebar>
  <BlogHeader slot="hero" frontmatter={frontmatter} headings={headings} length={length} />
  <section class="sm:max-w-sm w-full" data-content-type="md">
    <slot />
  </section>
  <TableOfContents slot="sidebar" frontmatter={frontmatter} headings={headings} />
</Base>
