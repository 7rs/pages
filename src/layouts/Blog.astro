---
import type { Props as MainProps } from "@layouts/Main.astro";
import type { Blog as BlogFrontmatter } from "@content/config";

import type { MarkdownHeading } from "astro";
import BlogHeader from "./blog/BlogHeader.astro";
import Base from "./Base.astro";

interface Props extends MainProps {
  frontmatter?: BlogFrontmatter;
  headings?: MarkdownHeading[];
  lang?: string;
  slug?: string;
  length?: number;
}

const { frontmatter = {}, headings, lang, slug, length, ...props } = Astro.props;
const title = frontmatter.title || "No title";
---

<Base title={title} lang={lang} showFakeHeader={false} showHero showSidebar>
  <BlogHeader slot="hero" frontmatter={frontmatter} headings={headings} length={length} />
  <section class="w-full min-[900px]:min-w-[600px] min-[900px]:max-w-[700px]">
    <slot />
  </section>
  <section slot="sidebar" class="h-full min-[900px]:min-w-[200px] min-[900px]:max-w-[300px] sticky top-0 right-0 mt-0 mb-auto">
    <div>{headings.map(heading => <p>{heading.slug}</p>)
      }</div>
  </section>
</Base>
