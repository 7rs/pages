---
import { format } from "@formkit/tempo";

import Main from "@layouts/Main.astro";
import type { Props as MainProps } from "@layouts/Main.astro";
import AnimatedAnchor from "@components/AnimatedAnchor.astro";
import Symbol from "@components/Symbol.astro";
import type { Blog as BlogFrontmatter } from "@content/config";
import { Icon } from "astro-icon/components";

interface Props extends MainProps {
  frontmatter?: BlogFrontmatter;
}

const { frontmatter, ...props } = Astro.props;
const title = frontmatter.title || "No title";
---

<Main title={title} className=" !min-[700px]:max-w-[700px]" showFakeHeader={false} {...props}>
  <section class="flex flex-col justify-center items-center gap-y-8 pt-16 min-h-svh">
    {frontmatter.image && <Symbol image={frontmatter.image} className="size-24 md:size-32" />}
    <h1 class="text-2xl md:text-5xl text-center font-bold w-full">{title}</h1>
    <div class="flex flex-col items-center gap-y-2 w-full">
      <div class="flex flex-wrap gap-x-2 color-[#A00] w-full justify-center">
        {
          frontmatter.authors.map((author) => (
            <AnimatedAnchor href={`/authors/${author}`} openAsNew={false}>
              @{author}
            </AnimatedAnchor>
          ))
        }
      </div>
      <div class="color-[#f80] flex flex-wrap justify-center gap-x-1 items-center w-full">
        <Icon name="line-md:plus" />
        <time datetime={frontmatter.created.toString()}>
          {format({ date: frontmatter.created, format: "YYYY-MM-DD Z", tz: "Asia/Tokyo" })}
        </time>
      </div>
      <div class="flex flex-wrap gap-x-2 color-[#337ab7] w-full justify-center">
        {
          frontmatter.tags.map((tag) => (
            <AnimatedAnchor href={`/tags/${tag}`} openAsNew={false}>
              #{tag}
            </AnimatedAnchor>
          ))
        }
      </div>
    </div>
  </section>
  <section data-content-type="md">
    <slot />
  </section>
</Main>
