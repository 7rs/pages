---
import { Icon } from "astro-icon/components";

import AnimatedAnchor from "@components/common/AnimatedAnchor.svelte";
import LinkIcon from "@components/LinkIcon.astro";

interface Navigation {
  url: string;
  label: string;
}

interface Social {
  url: string;
  icon: string;
  color?: string;
}

export interface Props {
  navigations?: Navigation[];
  socials?: Social[];
}
const { navigations = [], socials = [] } = Astro.props;
---

<footer class="footer-layout">
  <div class="footer-body">
    <nav class="footer-navs">
      {
        navigations.map((nav) => (
          <AnimatedAnchor openAsNew={false} href={nav.url}>
            {nav.label.toLocaleUpperCase()}
          </AnimatedAnchor>
        ))
      }
    </nav>
    <nav class="footer-socials">
      {socials.map((social) => <LinkIcon href={social.url} icon={social.icon} color={social.color} />)}
    </nav>
    <p class="footer-copyright">
      No copyright <Icon class="inline" name="cib:creative-commons-zero" />
      {new Date().getFullYear()} - No right reserved except for things that not made by me.
    </p>
  </div>
</footer>
