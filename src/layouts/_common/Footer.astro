---
import { Icon } from "astro-icon/components";

import AnimatedAnchor from "@components/AnimatedAnchor.astro";
import LinkIcon from "@components/LinkIcon.astro";

interface Navigation {
  url: string;
  label: string;
}

interface Social {
  url: string;
  icon: string;
  color?: string;
}

export interface Props {
  navigations?: Navigation[];
  socials?: Social[];
}

const { navigations = [], socials = [] } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="grid-area-[footer] w-full | flex justify-center | bg-base-100">
  <div class="py-10 px-4 sm:px-0 max-w-lg w-full | flex flex-col gap-y-8 | text-base">
    <nav class="w-full flex flex-wrap justify-center gap-x-8">
      {navigations.map((nav) => <AnimatedAnchor openAsNew={false} href={nav.url}>{nav.label.toLocaleUpperCase()}</AnimatedAnchor>)}
    </nav>

    <nav class="px-4 sm:px-0 w-full | flex flex-wrap justify-around sm:justify-center sm:gap-x-8">
      {socials.map((social) => <LinkIcon href={social.url} icon={social.icon} color={social.color} />)}
    </nav>

    <p class="w-full inline text-center">
      No copyright <Icon class="inline" name="cib:creative-commons-zero" />
      {year} - No right reserved except for things that not made by me.
    </p>
  </div>
</footer>
