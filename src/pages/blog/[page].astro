---
import Main from "@layouts/Main.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { getRawTextContent } from "@scripts/blogUtil";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import Pagenation from "@components/Pagenation.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const getTimestamp = (date) => (date ? date.getTime() : 0);

  return paginate(
    (await getCollection("blog")).sort(
      (prev, next) => getTimestamp(next.data.created) - getTimestamp(prev.data.created),
    ),
    { pageSize: 12 },
  );
}) satisfies GetStaticPaths;

const entries = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<Main title="Blog articles - 7rs.dev" className="my-12 | flex flex-col gap-y-36 justify-between" showFakeHeader={false}>
  <section class="flex flex-col">
    <div class="grid grid-cols-1 md:grid-cols-2 auto-rows-auto gap-2">
      {
        entries.page.data.map((entry) => (
          <ArticleCard slug={entry.slug} frontmatter={entry.data} length={getRawTextContent(entry.body).length} />
        ))
      }
    </div>
  </section>
  {entries.page.lastPage > 1 && <Pagenation page={entries.page} baseUrl="/blog" />}
</Main>
