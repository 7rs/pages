// SVGパス事前解析
function parseSVGPathStatic(pathString) {
  const vertices = [];
  let currentX = 0, currentY = 0;
  let startX = 0, startY = 0;
  
  const pathData = pathString.replace(/([MmLlHhVvCcSsQqTtAaZz])/g, '|$1').split('|').filter(s => s.length > 0);
  
  for (let segment of pathData) {
    const command = segment[0];
    const args = segment.slice(1).match(/[-+]?(?:\d*\.?\d+(?:[eE][-+]?\d+)?)/g);
    const numbers = args ? args.map(parseFloat) : [];
    
    switch (command) {
      case 'M':
        currentX = numbers[0];
        currentY = numbers[1];
        startX = currentX;
        startY = currentY;
        vertices.push(currentX, currentY);
        break;
        
      case 'C':
        for (let i = 0; i < numbers.length; i += 6) {
          if (i + 5 < numbers.length) {
            const cp1x = numbers[i];
            const cp1y = numbers[i + 1];
            const cp2x = numbers[i + 2];
            const cp2y = numbers[i + 3];
            const endX = numbers[i + 4];
            const endY = numbers[i + 5];
            
            for (let t = 0.02; t <= 1; t += 0.02) {
              const x = Math.pow(1-t, 3) * currentX + 
                       3 * Math.pow(1-t, 2) * t * cp1x + 
                       3 * (1-t) * Math.pow(t, 2) * cp2x + 
                       Math.pow(t, 3) * endX;
              const y = Math.pow(1-t, 3) * currentY + 
                       3 * Math.pow(1-t, 2) * t * cp1y + 
                       3 * (1-t) * Math.pow(t, 2) * cp2y + 
                       Math.pow(t, 3) * endY;
              vertices.push(x, y);
            }
            
            currentX = endX;
            currentY = endY;
          }
        }
        break;
        
      case 'Z':
      case 'z':
        if (vertices.length >= 4) {
          vertices.push(startX, startY);
        }
        break;
    }
  }
  
  return vertices;
}

// ガウシアンカーネル事前計算
function generateGaussianKernel(size, sigma) {
  const kernel = [];
  let sum = 0.0;
  const half = Math.floor(size / 2);
  
  for (let i = 0; i < size; i++) {
    const x = i - half;
    const weight = Math.exp(-(x * x) / (2 * sigma * sigma));
    kernel.push(weight);
    sum += weight;
  }
  
  // 正規化
  for (let i = 0; i < size; i++) {
    kernel[i] /= sum;
  }
  
  return kernel;
}

// 楕円頂点事前計算
function generateEllipseVertices(cx, cy, rx, ry, segments = 100) {
  const vertices = [];
  for (let i = 0; i <= segments; i++) {
    const angle = (i / segments) * Math.PI * 2;
    const x = cx + Math.cos(angle) * rx;
    const y = cy + Math.sin(angle) * ry;
    vertices.push(x, y);
  }
  return vertices;
}

// デフォルト設定用のパスデータ
const defaultPaths = [
  "M20,-4.3C35.9,-4.1,65.7,-2.1,74.2,8.5C82.7,19.1,70,38.2,54.1,40.8C38.2,43.3,19.1,29.4,7.6,21.8C-3.9,14.2,-7.7,12.9,-13.4,10.3C-19.1,7.7,-26.7,3.9,-36,-9.3C-45.3,-22.5,-56.4,-45,-50.7,-45.2C-45,-45.3,-22.5,-23,-10.2,-12.7C2.1,-2.5,4.1,-4.4,20,-4.3Z",
  "M32,-40.6C32.1,-32,16.1,-16,19.9,3.8C23.7,23.6,47.2,47.1,47.1,59.3C47.1,71.6,23.6,72.4,6.5,66C-10.7,59.5,-21.3,45.8,-35.9,33.5C-50.5,21.3,-69,10.7,-74.3,-5.3C-79.5,-21.2,-71.5,-42.3,-56.9,-50.9C-42.3,-59.5,-21.2,-55.5,-2.6,-52.9C16,-50.3,32,-49.1,32,-40.6Z",
  "M48.3,-52.3C55.2,-41.4,48.5,-20.7,41.2,-7.2C34,6.2,26.3,12.4,19.3,24C12.4,35.7,6.2,52.8,-5.5,58.3C-17.3,63.9,-34.6,57.9,-50.3,46.2C-66,34.6,-80.2,17.3,-71.7,8.5C-63.3,-0.3,-32.1,-0.6,-16.3,-11.6C-0.6,-22.5,-0.3,-44.2,10.2,-54.4C20.7,-64.6,41.4,-63.3,48.3,-52.3Z",
  "M59.7,-62.3C72.6,-46.8,74.9,-23.4,64.6,-10.3C54.3,2.8,31.4,5.6,18.5,11.1C5.6,16.6,2.8,24.7,-3.7,28.3C-10.2,32,-20.4,31.3,-21.9,25.8C-23.4,20.4,-16.4,10.2,-21.1,-4.8C-25.9,-19.7,-42.5,-39.4,-40.9,-54.9C-39.4,-70.4,-19.7,-81.7,1.9,-83.6C23.4,-85.5,46.8,-77.9,59.7,-62.3Z"
];

// デフォルト設定用の変換データ
const defaultConfigs = [
  { color: [168/255, 210/255, 240/255, 1], transform: {scale: 5, translateX: 128, translateY: 448} },
  { color: [199/255, 123/255, 242/255, 1], transform: {scale: 5, translateX: 960, translateY: 128} },
  { color: [252/255, 235/255, 194/255, 1], transform: {scale: 10, translateX: 960, translateY: 704} },
  { color: [255/255, 203/255, 163/255, 1], transform: {scale: 4, translateX: 64, translateY: 960, rotation: -30 * Math.PI / 180} }
];

// 事前計算（デフォルト用）
const precomputedPaths = defaultPaths.map(path => parseSVGPathStatic(path));
const precomputedEllipse = generateEllipseVertices(256, 256, 512, 512, 100);
const precomputedKernel = generateGaussianKernel(31, 64.0);
const pathConfigs = defaultConfigs;
