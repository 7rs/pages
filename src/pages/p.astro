<html>
  <head>
    <title>Playground</title>
    <meta charset="UTF-8" />
  </head>
  <body>
    <main>
      <div class="collapse collapse-arrow">
        <input title="what" type="checkbox" />
        <div class="collapse-title">what</div>
        <div class="collapse-content">your content here should display</div>
      </div>
    </main>
  </body>
</html>

<style>
  .collapse {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-box, 1rem);
    width: 100%;
    grid-template-rows: max-content 0fr;
    transition: grid-template-rows 0.2s;
    isolation: isolate;
  }

  .collapse-title {
    position: relative;
    width: 100%;
    padding: 1rem;
    padding-inline-end: 3rem;
    min-height: 1lh;
    transition: background-color 0.2s ease-out;
  }

  .collapse-content {
    visibility: hidden;
    grid-column-start: 1;
    grid-row-start: 2;
    min-height: 0;
    padding-left: 1rem;
    padding-right: 1rem;
    cursor: unset;
    transition:
      visibility 0.2s,
      padding 0.2s ease-out,
      background-color 0.2s ease-out;
  }
</style>
