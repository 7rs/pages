---

<html>
  <head>
    <title>Playground</title>
    <meta charset="UTF-8" />
  </head>
  <body
    data-show-hero={false}
    data-show-sidebar={true}
    class="min-h-dvh w-full | grid grid-rows-[auto_1fr_auto] place-items-center | bg-base-200"
  >
  </body>
</html>

<style lang="scss">
  body[data-show-hero="false"][data-show-sidebar="false"] {
    grid-template-areas:
      "header "
      "main"
      "footer";
  }

  body[data-show-hero="true"][data-show-sidebar="false"] {
    grid-template-areas:
      "header"
      "hero"
      "main"
      "footer";
  }

  body[data-show-hero="false"][data-show-sidebar="true"] {
    grid-template-areas:
      "header   header "
      "main     sidebar"
      "footer  footer";
  }

  body[data-show-hero="true"][data-show-sidebar="true"] {
    grid-template-areas:
      "header   header "
      "hero     hero   "
      "main     sidebar"
      "footer  footer";
  }
</style>
