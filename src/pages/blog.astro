---
import Main from "@layouts/Main.astro";
import { getCollection } from "astro:content";
import Symbol from "@components/Symbol.astro";
import type { Blog as BlogFrontmatter } from "@content/config";
import ArticleCard from "@components/ArticleCard.astro";

const entries = await getCollection("blog");
---

<Main title="Fast, Lean and Customizable! - 7rs.dev" className="mb-12 | flex flex-col gap-y-36" showFakeHeader={false}>
  <article class="flex flex-col">
    <div class="grid grid-cols-1 md:grid-cols-2 auto-rows-fr gap-2">
      {entries.map((entry) => <ArticleCard slug={entry.slug} frontmatter={entry.data} />)}
    </div>
  </article>
</Main>
