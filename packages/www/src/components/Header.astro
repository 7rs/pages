---
import { ThemeButton } from '@7rs/pages-ui';

export interface Props {
  putFakeHeader?: boolean;
}

const { putFakeHeader = true } = Astro.props;
---

<header class="px-2 md:px-0 h-16 w-full fixed top-0 left-0 flex justify-center bg-base-200">
  <div class="max-w-3xl relative navbar">
    <section class="flex-1">
      <h1 class="text-xl">7rs.dev</h1>
    </section>
    <section class="flex-none flex items-center text-2xl">
      <ThemeButton lightTheme="emerald" darkTheme="dracula" className="icon" />
    </section>
  </div>
</header>

{putFakeHeader && <div class="h-16 w-full bg-base-100" />}
