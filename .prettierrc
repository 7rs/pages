{
    "printWidth": 120,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": false,
    "semi": true,
    "endOfLine": "lf",
    "options.editorconfig": true,
    "plugins": ["prettier-plugin-astro", "prettier-plugin-svelte"],
    "astroAllowShorthand": false,
    "overrides": [
        {
            "files": [".prettierrc", "*.json"],
            "options": {
                "parser": "json",
                "tabWidth": 4
            }
        },
        {
            "files": [
                "**/*.js",
                "**/*.mjs",
                "**/*.ts",
                "**/*.d.ts",
                "**/*.json",
                "**/*.astro",
                "**/*.svelte",
                "**/.prettierrc"
            ],
            "options": {
                "singleQuote": true
            }
        }
    ]
}
